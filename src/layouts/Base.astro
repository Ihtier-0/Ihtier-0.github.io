---
import { getLangFromUrl, getOtherLang, t } from "../i18n";
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import NavSidebar from "../components/NavSidebar.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title: string;
  description?: string;
  pagefind?: boolean;
}

const fm = (Astro.props as any).frontmatter;
const title = fm?.title ?? Astro.props.title;
const description = fm?.description ?? Astro.props.description ?? "Ihtier-0 Blog — C++ and Systems Programming";
const pagefind = fm?.pagefind ?? Astro.props.pagefind ?? true;
const lang = getLangFromUrl(Astro.url);
const otherLang = getOtherLang(lang);
const switchUrl = Astro.url.pathname.replace(`/${lang}/`, `/${otherLang}/`);
const path = Astro.url.pathname;

// Full nav for desktop header (articles, etudes, portfolio, about)
const navItems = [
  { href: `/${lang}/articles/`, label: t(lang, "nav.articles") },
  { href: `/${lang}/etudes/`, label: t(lang, "nav.etudes") },
  { href: `/${lang}/portfolio/`, label: t(lang, "nav.portfolio") },
  { href: `/${lang}/about/`, label: t(lang, "nav.about") },
];

// Blog-only items for the sidebar's "Blog" sub-section (About is a separate sidebar item)
const blogNavItems = [
  { href: `/${lang}/articles/`, label: t(lang, "nav.articles") },
  { href: `/${lang}/etudes/`, label: t(lang, "nav.etudes") },
  { href: `/${lang}/portfolio/`, label: t(lang, "nav.portfolio") },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="alternate" hreflang={otherLang} href={switchUrl} />
    <title>{title}</title>
    <script is:inline>
      (function(){
        try { var t = localStorage.getItem("theme") || "dark"; } catch(e) { var t = "dark"; }
        document.documentElement.setAttribute("data-theme", t);
        var seg = location.pathname.split("/").filter(Boolean);
        if (seg[0] === "en" || seg[0] === "ru") localStorage.setItem("lang", seg[0]);
      })();
    </script>
  </head>
  <body>
    <SiteHeader lang={lang} otherLang={otherLang} switchUrl={switchUrl} navItems={navItems} path={path} />
    <NavSidebar lang={lang} navItems={blogNavItems} path={path} />
    <main id="main-content" {...(pagefind ? { "data-pagefind-body": "" } : {})}>
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>
