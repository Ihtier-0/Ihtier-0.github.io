---
import Base from "../../../layouts/Base.astro";
import PostList from "../../../components/PostList.astro";
import { t } from "../../../i18n";

const mods = import.meta.glob("./*.mdx", { eager: true });
const posts = Object.values(mods)
  .map((a: any) => ({
    url: a.url,
    title: a.frontmatter.title,
    date: a.frontmatter.date ? new Date(a.frontmatter.date).toISOString().slice(0, 10) : "",
    summary: a.frontmatter.summary || "",
  }))
  .sort((a, b) => (b.date > a.date ? 1 : -1));
---

<Base title={`${t("ru", "page.showcase")} — Ihtier-0 blog`}>
  <h2 style="margin-bottom:1.5rem">{t("ru", "page.showcase")}</h2>
  <PostList posts={posts} lang="ru" emptyKey="list.empty.showcase" />
</Base>
