---
import { getLangFromUrl, getOtherLang, languages, t } from "../i18n";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Ihtier-0 Blog — C++ and Systems Programming" } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const otherLang = getOtherLang(lang);
const switchUrl = Astro.url.pathname.replace(`/${lang}/`, `/${otherLang}/`);
const path = Astro.url.pathname;

const navItems = [
  { href: `/${lang}/articles/`, label: t(lang, "nav.articles") },
  { href: `/${lang}/etudes/`, label: t(lang, "nav.etudes") },
  { href: `/${lang}/showcase/`, label: t(lang, "nav.showcase") },
  { href: `/${lang}/about/`, label: t(lang, "nav.about") },
];

function isActive(href: string) {
  return path === href || path === href.replace(/\/$/, "");
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="alternate" hreflang={otherLang} href={switchUrl} />
    <title>{title}</title>
    <script is:inline>
      (function(){
        try { var t = localStorage.getItem("theme") || "dark"; } catch(e) { var t = "dark"; }
        document.documentElement.setAttribute("data-theme", t);
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <header class="site-header">
      <div class="header-left">
        <button id="nav-toggle" class="nav-toggle" aria-label="Menu">&#9776;</button>
        <h1><a href={`/${lang}/`}>{t(lang, "site.title")}</a></h1>
        <nav class="desktop-nav">
          {navItems.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
      <div class="header-right">
        <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme"></button>
        <a class="lang-switch" id="lang-switch" href={switchUrl}>{languages[otherLang]}</a>
        <div class="search-wrapper">
          <input type="text" id="search-input" placeholder={t(lang, "search.placeholder")} />
          <div class="search-results" id="search-results"></div>
        </div>
      </div>
    </header>

    <div id="nav-overlay" class="nav-overlay"></div>
    <nav id="nav-sidebar" class="nav-sidebar">
      <div class="nav-sidebar-header">
        <button id="nav-close" class="nav-close" aria-label="Close">&times;</button>
      </div>
      <ul class="nav-links">
        <li><a href={`/${lang}/`} aria-current={isActive(`/${lang}/`) ? "page" : undefined}>{t(lang, "nav.home")}</a></li>
        <li class="nav-section">{t(lang, "nav.blog")}</li>
        {navItems.map((item) => (
          <li><a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <main id="main-content" data-pagefind-body>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-row">
        <span class="footer-copy">&copy; 2026–Present Ihtier-0</span>
        <span class="footer-sep">·</span>
        <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>
        <span class="footer-sep">·</span>
        <span class="footer-copy">{t(lang, "footer.built")} <a href="https://astro.build">Astro</a></span>
      </div>
      <div class="footer-socials">
        <a href="https://github.com/Ihtier-0" aria-label="GitHub" title="GitHub">
