    <p style="color:var(--text-muted); margin-bottom:2rem">Page not found / Страница не найдена</p>
    <div style="display:flex; gap:1rem; justify-content:center; flex-wrap:wrap">
      <a href="/en/">English Home</a>
      <a href="/ru/">Русская версия</a>
    </div>
  </div>
</Base>
