---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import PostList from "../../../components/PostList.astro";
import { t } from "../../../i18n";
import type { Lang } from "../../../i18n";

export async function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "ru" } }];
}

const lang = Astro.params.lang as Lang;
const entries = await getCollection("etudes", (e) => e.id.startsWith(lang + "/"));
const posts = entries
  .map((e) => ({
    url: `/${lang}/etudes/${e.id.split("/").slice(1).join("/").replace(/\.(md|mdx)$/, "")}`,
    title: e.data.title,
    date: e.data.date ?? "",
    summary: e.data.summary ?? "",
  }))
  .sort((a, b) => (b.date > a.date ? 1 : -1));
---

<Base title={`${t(lang, "page.etudes")} — Ihtier-0 blog`} pagefind={false}>
  <h2 style="margin-bottom:1.5rem">{t(lang, "page.etudes")}</h2>
  <PostList posts={posts} lang={lang} emptyKey="list.empty.etudes" />
</Base>
