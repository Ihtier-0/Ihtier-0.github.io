---
interface Props {
  title?: string;
  fragment: string;
}

const { title = "GLSL Shader", fragment } = Astro.props;
const id = `shader-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="shader-editor" id={id}>
  <div class="shader-editor-header">
    <span>{title}</span>
    <span>GLSL — edit live</span>
  </div>
  <div class="shader-editor-body">
    <textarea spellcheck="false">{fragment.trim()}</textarea>
    <canvas width="400" height="400"></canvas>
  </div>
  <div class="shader-error"></div>
</div>

<script>
  function initShaderEditors() {
    document.querySelectorAll<HTMLDivElement>(".shader-editor").forEach((editor) => {
      const textarea = editor.querySelector("textarea")!;
      const canvas = editor.querySelector("canvas")!;
      const errorEl = editor.querySelector<HTMLDivElement>(".shader-error")!;

      const gl = canvas.getContext("webgl")!;
      if (!gl) return;

      const vertSrc = `attribute vec2 a_position;
void main() { gl_Position = vec4(a_position, 0.0, 1.0); }`;

      function createShader(type: number, src: string) {
        const s = gl.createShader(type)!;
        gl.shaderSource(s, src);
        gl.compileShader(s);
        if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) {
          const err = gl.getShaderInfoLog(s);
          gl.deleteShader(s);
          throw new Error(err || "Compile error");
        }
        return s;
      }

      const vert = createShader(gl.VERTEX_SHADER, vertSrc);
      const buf = gl.createBuffer()!;
      gl.bindBuffer(gl.ARRAY_BUFFER, buf);
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);

      let program: WebGLProgram | null = null;
      let animId = 0;
      const startTime = performance.now();

      function compile(fragSrc: string) {
        try {
          const frag = createShader(gl.FRAGMENT_SHADER, fragSrc);
          const prog = gl.createProgram()!;
          gl.attachShader(prog, vert);
          gl.attachShader(prog, frag);
          gl.linkProgram(prog);

          if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {
            throw new Error(gl.getProgramInfoLog(prog) || "Link error");
          }

          if (program) gl.deleteProgram(program);
          program = prog;
          errorEl.textContent = "";
          errorEl.classList.remove("active");
        } catch (e: any) {
          errorEl.textContent = e.message;
          errorEl.classList.add("active");
        }
      }

      function render() {
        if (!program) { animId = requestAnimationFrame(render); return; }

        canvas.width = canvas.clientWidth;
        canvas.height = canvas.clientHeight;
        gl.viewport(0, 0, canvas.width, canvas.height);

        gl.useProgram(program);

        const pos = gl.getAttribLocation(program, "a_position");
        gl.bindBuffer(gl.ARRAY_BUFFER, buf);
        gl.enableVertexAttribArray(pos);
        gl.vertexAttribPointer(pos, 2, gl.FLOAT, false, 0, 0);

        const uTime = gl.getUniformLocation(program, "u_time");
        if (uTime) gl.uniform1f(uTime, (performance.now() - startTime) / 1000);

        const uRes = gl.getUniformLocation(program, "u_resolution");
        if (uRes) gl.uniform2f(uRes, canvas.width, canvas.height);

        gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
        animId = requestAnimationFrame(render);
      }

      compile(textarea.value);
      render();

      let timeout: number;
      textarea.addEventListener("input", () => {
        clearTimeout(timeout);
        timeout = window.setTimeout(() => compile(textarea.value), 300);
      });

      // Cleanup when element is removed
      const observer = new MutationObserver(() => {
        if (!document.contains(editor)) {
          cancelAnimationFrame(animId);
          observer.disconnect();
        }
      });
      observer.observe(document.body, { childList: true, subtree: true });
    });
  }

  initShaderEditors();
</script>
