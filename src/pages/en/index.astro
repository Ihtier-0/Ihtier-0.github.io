---
import Base from "../../layouts/Base.astro";
import MixedFeed from "../../components/MixedFeed.astro";

const articleMods = import.meta.glob("./articles/*.mdx", { eager: true });
const etudeMods = import.meta.glob("./etudes/*.mdx", { eager: true });
const showcaseMods = import.meta.glob("./showcase/*.mdx", { eager: true });

function toList(mods: Record<string, any>, type: string) {
  return Object.values(mods).map((a: any) => ({
    url: a.url,
    title: a.frontmatter.title,
    date: a.frontmatter.date ? new Date(a.frontmatter.date).toISOString().slice(0, 10) : "",
    summary: a.frontmatter.summary || "",
    type,
  }));
}

const all = [...toList(articleMods, "article"), ...toList(etudeMods, "etude"), ...toList(showcaseMods, "showcase")]
  .sort((a, b) => (b.date > a.date ? 1 : -1));
---

<Base title="Ihtier-0 blog">
  <MixedFeed posts={all} lang="en" />
</Base>
