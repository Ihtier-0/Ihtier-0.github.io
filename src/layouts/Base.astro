---
import { getLangFromUrl, getOtherLang, languages, t } from "../i18n";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Ihtier-0 Blog — C++ and Systems Programming" } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const otherLang = getOtherLang(lang);
const switchUrl = Astro.url.pathname.replace(`/${lang}/`, `/${otherLang}/`);
const path = Astro.url.pathname;

const navItems = [
  { href: `/${lang}/articles/`, label: t(lang, "nav.articles") },
  { href: `/${lang}/etudes/`, label: t(lang, "nav.etudes") },
  { href: `/${lang}/showcase/`, label: t(lang, "nav.showcase") },
  { href: `/${lang}/about/`, label: t(lang, "nav.about") },
];

function isActive(href: string) {
  return path === href || path === href.replace(/\/$/, "");
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="alternate" hreflang={otherLang} href={switchUrl} />
    <title>{title}</title>
    <script is:inline>
      (function(){
        try { var t = localStorage.getItem("theme") || "dark"; } catch(e) { var t = "dark"; }
        document.documentElement.setAttribute("data-theme", t);
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <header class="site-header">
      <div class="header-left">
        <button id="nav-toggle" class="nav-toggle" aria-label="Menu">&#9776;</button>
        <h1><a href={`/${lang}/`}>{t(lang, "site.title")}</a></h1>
        <nav class="desktop-nav">
          {navItems.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
      <div class="header-right">
        <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme"></button>
        <a class="lang-switch" href={switchUrl}>{languages[otherLang]}</a>
        <div class="search-wrapper">
          <input type="text" id="search-input" placeholder={t(lang, "search.placeholder")} />
          <div class="search-results" id="search-results"></div>
        </div>
      </div>
    </header>

    <div id="nav-overlay" class="nav-overlay"></div>
    <nav id="nav-sidebar" class="nav-sidebar">
      <div class="nav-sidebar-header">
        <button id="nav-close" class="nav-close" aria-label="Close">&times;</button>
      </div>
      <ul class="nav-links">
        <li><a href={`/${lang}/`} aria-current={isActive(`/${lang}/`) ? "page" : undefined}>{t(lang, "nav.home")}</a></li>
        <li class="nav-section">{t(lang, "nav.blog")}</li>
        {navItems.map((item) => (
          <li><a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <main id="main-content" data-pagefind-body>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <nav class="footer-nav">
          {navItems.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
        <div class="footer-links">
          <a href="https://github.com/Ihtier-0">GitHub</a>
          <a href="https://t.me/ihtier0">Telegram</a>
          <a href="https://www.linkedin.com/in/ihtier0">LinkedIn</a>
        </div>
        <p class="footer-copy">&copy; {new Date().getFullYear()} Ihtier-0. {t(lang, "footer.built")} <a href="https://astro.build">Astro</a>.</p>
      </div>
    </footer>

    <script define:vars={{ lang }}>
      window.__LANG__ = lang;
    </script>
    <script is:inline>
      (function(){
        var btn = document.getElementById("theme-toggle");
        function update() {
          var t = document.documentElement.getAttribute("data-theme");
          btn.textContent = t === "dark" ? "\u2600\uFE0F" : "\uD83C\uDF19";
        }
        update();
        btn.addEventListener("click", function(){
          var curr = document.documentElement.getAttribute("data-theme");
          var next = curr === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", next);
          try { localStorage.setItem("theme", next); } catch(e) {}
          update();
        });
      })();
    </script>
    <script is:inline>
      (function(){
        var toggle = document.getElementById("nav-toggle");
        var close = document.getElementById("nav-close");
        var sidebar = document.getElementById("nav-sidebar");
        var overlay = document.getElementById("nav-overlay");
        function open() {
          sidebar.classList.add("open");
          overlay.classList.add("open");
          close.focus();
        }
        function shut() {
          sidebar.classList.remove("open");
          overlay.classList.remove("open");
          toggle.focus();
        }
        toggle.addEventListener("click", open);
        close.addEventListener("click", shut);
        overlay.addEventListener("click", shut);
        document.addEventListener("keydown", function(e) {
          if (e.key === "Escape" && sidebar.classList.contains("open")) shut();
        });
        sidebar.addEventListener("keydown", function(e) {
          if (e.key !== "Tab") return;
          var focusable = sidebar.querySelectorAll("button, a[href]");
          var first = focusable[0];
          var last = focusable[focusable.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault(); last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault(); first.focus();
          }
        });
      })();
    </script>
    <script is:inline>
      (function() {
        var input = document.getElementById("search-input");
        var results = document.getElementById("search-results");
        var pagefind = null;

        input.addEventListener("focus", async function() {
          if (!pagefind) {
            try {
              pagefind = await import("/pagefind/pagefind.js");
              await pagefind.init();
            } catch(e) {
              return;
            }
          }
        });

        input.addEventListener("input", async function() {
          var query = input.value.trim();
          if (!query || !pagefind) {
            results.classList.remove("active");
            return;
          }

          var search = await pagefind.search(query);
          var items = await Promise.all(search.results.slice(0, 5).map(function(r) { return r.data(); }));

          if (items.length === 0) {
            results.innerHTML = '<div style="padding:0.6rem 0.8rem;color:var(--text-muted)">' +
              (window.__LANG__ === "ru" ? "Ничего не найдено" : "Nothing found") +
            '</div>';
          } else {
            results.innerHTML = items
              .map(function(item) { return '<a href="' + item.url + '">' + (item.meta?.title || item.url) + '</a>'; })
              .join("");
          }
          results.classList.add("active");
        });

        document.addEventListener("click", function(e) {
          if (!e.target.closest(".search-wrapper")) {
            results.classList.remove("active");
          }
        });
      })();
    </script>
    <script is:inline>
      (function(){
        document.querySelectorAll(".article-content pre").forEach(function(pre) {
          var btn = document.createElement("button");
          btn.className = "copy-btn";
          btn.textContent = "Copy";
          btn.addEventListener("click", function() {
            var code = pre.querySelector("code");
            var text = (code || pre).textContent;
            navigator.clipboard.writeText(text).then(function() {
              btn.textContent = "Copied!";
              btn.classList.add("copied");
              setTimeout(function() {
                btn.textContent = "Copy";
                btn.classList.remove("copied");
              }, 1500);
            });
          });
          pre.appendChild(btn);
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 1rem;
    z-index: 999;
    padding: 0.5rem 1rem;
    background: var(--accent);
    color: #fff;
    border-radius: 4px;
    font-size: 0.9rem;
  }

  .skip-link:focus {
    top: 0.5rem;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .header-right > *,
  .header-right .search-wrapper input {
    height: 2rem;
  }

  .lang-switch {
    font-size: 0.85rem;
    padding: 0 0.6rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 5rem;
  }

  .lang-switch:hover {
    border-color: var(--accent);
    text-decoration: none;
  }

  .theme-toggle {
    background: none;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0 0.5rem;
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
  }

  .theme-toggle:hover {
    border-color: var(--accent);
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .nav-toggle {
    background: none;
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text);
    cursor: pointer;
    font-size: 1.2rem;
    height: 2rem;
    width: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  .nav-toggle:hover {
    border-color: var(--accent);
  }

  .nav-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 200;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s, visibility 0.25s;
  }

  .nav-overlay.open {
    opacity: 1;
    visibility: visible;
  }

  .nav-sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: 280px;
    height: 100vh;
    background: var(--bg-surface);
    border-right: 1px solid var(--border);
    z-index: 300;
    transform: translateX(-100%);
    transition: transform 0.25s ease;
    overflow-y: auto;
  }

  .nav-sidebar.open {
    transform: translateX(0);
  }

  .nav-sidebar-header {
    display: flex;
    justify-content: flex-end;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border);
  }

  .nav-close {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 1.5rem;
    cursor: pointer;
    padding: 0;
    line-height: 1;
  }

  .nav-close:hover {
    color: var(--text);
  }

  .nav-links {
    list-style: none;
    padding: 0.5rem 0;
  }

  .nav-links li a {
    display: block;
    padding: 0.6rem 1.5rem;
    color: var(--text);
    font-size: 0.95rem;
  }

  .nav-links li a:hover {
    background: var(--bg-code);
    text-decoration: none;
  }

  .nav-section {
    padding: 0.8rem 1.5rem 0.3rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .nav-links li a[aria-current="page"] {
    color: var(--accent);
    background: var(--bg-code);
  }

  .desktop-nav {
    display: none;
    align-items: center;
    gap: 0.25rem;
    margin-left: 0.5rem;
  }

  .desktop-nav a {
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    font-size: 0.85rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .desktop-nav a:hover {
    color: var(--text);
    background: var(--bg-code);
    text-decoration: none;
  }

  .desktop-nav a[aria-current="page"] {
    color: var(--accent);
  }

  @media (min-width: 768px) {
    .desktop-nav {
      display: flex;
    }

    .nav-toggle {
      display: none;
    }
  }

  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: 4rem;
    padding: 2rem 1.5rem;
  }

  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    text-align: center;
  }

  .footer-nav {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .footer-nav a {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .footer-nav a:hover {
    color: var(--text);
    text-decoration: none;
  }

  .footer-links {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .footer-links a {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .footer-links a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .footer-copy {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
</style>
